# This replaces .gitignore for EAS. Deny everything, then allow build inputs.
/*
!/app
!/assets
!/auth
!/components
!/constants
!/hooks
!/redux
!/screens
!/package.json
!/package-lock.json
!/app.json
!/app.config.js
!/eas.json
!/.easignore
!/babel.config.js
!/metro.config.js
!/tailwind.config.js
!/tsconfig.json
!/global.css
!/nativewind-env.d.ts

# Defense in depth inside the allowed directories. No local credentials,
# generated artifacts, backend files, tests, reports, or signing material.
**/.git/
**/node_modules/
**/.expo/
**/.env*
**/identity-private/
**/credentials.json
**/*.jks
**/*.keystore
**/*.key
**/*.pem
**/*.p8
**/*.p12
**/*.mobileprovision
**/*.apk
**/*.aab
**/*.ipa
**/*.zip
**/*.tar*
**/*.log
**/*.har
**/*storageState*
**/*.map
**/*.test.*
**/*.spec.*
**/.DS_Store
